# Copiez ce fichier en .env.local pour tester chez vous, et recopiez les mêmes noms dans Vercel
# (Settings > Environment Variables). Ne publiez JAMAIS ces valeurs sur GitHub.

# Base de données Supabase : Connect > « Transaction pooler » (port 6543)
DATABASE_URL=postgresql://postgres.xxxxx:MOTDEPASSE@aws-0-xx.pooler.supabase.com:6543/postgres

# Clé secrète qui signe les connexions : au moins 32 caractères aléatoires.
# Pour en générer une :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Adresse(s) e-mail autorisée(s) dans l'espace de gestion (séparées par des virgules)
ADMIN_EMAILS=vous@exemple.com

# Nom secret de l'espace de gestion = adresse ET code d'accès (raccourci Ctrl + Alt + B).
# 12 à 60 caractères : minuscules, chiffres et tirets. Choisissez un nom sans lien avec le site ni avec « admin ».
# Exemple : infographie-mgs-k7q2x9-dash       Sans cette variable, l'espace de gestion est désactivé.
ADMIN_PATH=

# Envoi du code par e-mail, option A : Gmail avec un « mot de passe d'application »
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Option B : Resend (resend.com). Utilisé seulement si SMTP_HOST est vide.
RESEND_API_KEY=

# Facultatif : transmettre aussi chaque brief à une autre API
MGS_ADMIN_API_URL=
MGS_ADMIN_API_KEY=
